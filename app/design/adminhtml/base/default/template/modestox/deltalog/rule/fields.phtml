<script type="text/javascript">
    //<![CDATA[
    var fieldRowCounter = 0;

    function addRuleFieldRow(data) {
        data = data || {};
        var id = 'new_' + fieldRowCounter++;
        var html = '<tr id="field_row_' + id + '">' +
            '<td><input type="text" name="fields[' + id + '][field_code]" value="' + (data.code || '') + '" class="input-text required-entry" /></td>' +
            '<td><input type="text" name="fields[' + id + '][field_label]" value="' + (data.label || '') + '" class="input-text required-entry" /></td>' +
            '<td>' +
            '<select name="fields[' + id + '][value_type]" class="select">' +
            '<option value="text"' + (data.type === 'text' ? ' selected' : '') + '><?php echo $helper->__('Text'); ?></option>' +
            '<option value="date"' + (data.type === 'date' ? ' selected' : '') + '><?php echo $helper->__('Date'); ?></option>' +
            '<option value="select"' + (data.type === 'select' ? ' selected' : '') + '><?php echo $helper->__('Select'); ?></option>' +
            '<option value="multiselect"' + (data.type === 'multiselect' ? ' selected' : '') + '><?php echo $helper->__('Multiselect'); ?></option>' +
            '<option value="boolean"' + (data.type === 'boolean' ? ' selected' : '') + '><?php echo $helper->__('Boolean'); ?></option>' +
            '</select>' +
            '</td>' +
            '<td><input type="text" name="fields[' + id + '][source_model]" value="' + (data.source_model || '') + '" class="input-text" /></td>' +
            '<td><input type="text" name="fields[' + id + '][helper_method]" value="" class="input-text" /></td>' +
            '<td>' +
            '<select name="fields[' + id + '][is_active]" class="select">' +
            '<option value="1"><?php echo $helper->__('Active'); ?></option>' +
            '<option value="0"><?php echo $helper->__('Disabled'); ?></option>' +
            '</select>' +
            '</td>' +
            '<td class="a-center">' +
            '<button type="button" class="button delete" onclick="removeRuleFieldRow(this)"><span><span><?php echo $helper->__('Delete'); ?></span></span></button>' +
            '</td>' +
            '</tr>';

        Element.insert($('rule_fields_container'), {bottom: html});
    }

    function removeRuleFieldRow(btn) {
        var row = $(btn).up('tr');
        if (row) {
            row.remove();
        }
    }

    function loadAvailableFields() {
        var tableNameInput = $('table_name');
        var entityTypeInput = $('entity_type');

        var tableName = tableNameInput ? tableNameInput.value.strip() : '';
        var entityType = entityTypeInput ? entityTypeInput.value.strip() : 'flat';

        if (!tableName || tableName === '') {
            alert('<?php echo $helper->__("Please fill in Database Table Name / Entity Code on the General Configuration tab first."); ?>');
            return;
        }

        new Ajax.Request('<?php echo Mage::helper("adminhtml")->getUrl("*/*/loadFields"); ?>', {
            method: 'get',
            parameters: {
                table_name: tableName,
                entity_type: entityType
            },
            onSuccess: function(response) {
                try {
                    var result = response.responseText.evalJSON();
                    if (result && result.length > 0) {
                        result.each(function(field) {
                            addRuleFieldRow(field);
                        });
                    } else {
                        alert('<?php echo $helper->__("No fields found or table does not exist."); ?>');
                    }
                } catch (e) {
                    alert('<?php echo $helper->__("Error parsing response from server."); ?>');
                }
            }
        });
    }
    //]]>
</script>