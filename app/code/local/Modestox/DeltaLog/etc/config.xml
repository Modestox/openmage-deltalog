    </global>

    <admin>
        <routers>
            <adminhtml>
                <args>
                    <modules>
                        <Modestox_DeltaLog before="Mage_Adminhtml">Modestox_DeltaLog_Adminhtml</Modestox_DeltaLog>
                    </modules>
                </args>
            </adminhtml>
        </routers>
    </admin>

    <adminhtml>
        <layout>
            <updates>
                <modestox_deltalog>
                    <file>modestox/modestox_deltalog.xml</file>
                </modestox_deltalog>
            </updates>
        </layout>
    </adminhtml>

    <default>
        <modestox_deltalog>
            <general>
                <enabled>1</enabled>
            </general>
        </modestox_deltalog>
    </default>
</config>