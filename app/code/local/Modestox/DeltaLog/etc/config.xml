<config>
    <modules>
        <Modestox_DeltaLog>
            <version>1.0.1</version>
        </Modestox_DeltaLog>
    </modules>
    <global>
        <blocks>
            <modestox_deltalog>
                <class>Modestox_DeltaLog_Block</class>
            </modestox_deltalog>
        </blocks>
        <helpers>
            <modestox_deltalog>
                <class>Modestox_DeltaLog_Helper</class>
            </modestox_deltalog>
        </helpers>
        <models>
            <modestox_deltalog>
                <class>Modestox_DeltaLog_Model</class>
                <resourceModel>modestox_deltalog_resource</resourceModel>
            </modestox_deltalog>
            <modestox_deltalog_resource>
                <class>Modestox_DeltaLog_Model_Resource</class>
                <entities>
                    <entry>
                        <table>modestox_delta_log_entry</table>
                    </entry>
                    <rule>
                        <table>modestox_delta_log_rule</table>
                    </rule>
                    <rule_field>
                        <table>modestox_delta_log_rule_field</table>
                    </rule_field>
                </entities>
            </modestox_deltalog_resource>
        </models>
        <resources>
            <modestox_deltalog_setup>
                <setup>
                    <module>Modestox_DeltaLog</module>
                </setup>
            </modestox_deltalog_setup>
        </resources>
        <events>
            <model_save_after>
                <observers>
                    <modestox_deltalog_save_after>
                        <type>singleton</type>
                        <class>modestox_deltalog/observer</class>
                        <method>executeOnModelSaveAfter</method>
                    </modestox_deltalog_save_after>
                </observers>
            </model_save_after>
        </events>
    </global>

    <admin>
        <routers>
            <adminhtml>
                <args>
                    <modules>
                        <Modestox_DeltaLog before="Mage_Adminhtml">Modestox_DeltaLog_Adminhtml</Modestox_DeltaLog>
                    </modules>
                </args>
            </adminhtml>
        </routers>
    </admin>

    <adminhtml>
        <layout>
            <updates>
                <modestox_deltalog>
                    <file>modestox/modestox_deltalog.xml</file>
                </modestox_deltalog>
            </updates>
        </layout>
        <translate>
            <modules>
                <Modestox_DeltaLog>
                    <files>
                        <default>modestox/Modestox_DeltaLog.csv</default>
                    </files>
                </Modestox_DeltaLog>
            </modules>
        </translate>
    </adminhtml>

    <crontab>
        <jobs>
            <modestox_deltalog_cleanup>
                <schedule>
                    <cron_expr>0 3 * * *</cron_expr>
                </schedule>
                <run>
                    <model>modestox_deltalog/cron::cleanOldLogs</model>
                </run>
            </modestox_deltalog_cleanup>
        </jobs>
    </crontab>

    <default>
        <modestox_deltalog>
            <general>
                <enabled>0</enabled>
                <tracking_mode>admin_only</tracking_mode>
                <retention_days>120</retention_days>
                <debug>0</debug>
            </general>
        </modestox_deltalog>
    </default>
</config>